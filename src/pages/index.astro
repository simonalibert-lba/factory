---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

const title = 'LBA Factory, applications métier, sites web et IA à Rabat';
const description = 'LBA Factory conçoit et développe vos applications métier, sites web et solutions d’IA depuis Rabat, adossée à une agence digitale en France.';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F5F5F5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Intro du logo : activée avant le premier affichage, sauf en mouvement réduit -->
    <script is:inline>try{if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('lbaf-intro')}catch(e){}</script>
  </head>
  <body>
    <div class="lbaf-root emph-couleur" dir="ltr" lang="fr" style="width: 100%; max-width: 2400px; margin-inline: auto; box-sizing: border-box; background: var(--surface-page); color: var(--text-primary);">
  <div class="intro" aria-hidden="true"><div class="intro-stage"><svg class="intro-logo" viewBox="0 0 330 63" width="330" height="63" aria-hidden="true" focusable="false"><g fill="#0A0A0A">
    <g data-g="l"><path d="M12 40.5842H30.9004V51.2639H0V8.54419H12V40.5842Z"/></g>
    <g data-g="b"><path d="M53.9521 8.54419C59.1119 8.54425 62.8915 9.56442 65.2314 11.6643C67.5714 13.7643 68.7119 16.3445 68.7119 19.4045C68.7118 23.5443 66.6716 26.724 63.1318 28.344C67.6318 29.964 70.4521 34.2843 70.4521 38.6643C70.4521 46.5242 65.2318 51.2638 54.3721 51.2639H32.7119V8.54419H53.9521ZM44.7119 41.844H53.7119C56.5916 41.8439 58.0311 40.5243 58.0312 37.9446C58.0312 35.3646 56.5918 34.0442 53.7119 34.0442H44.7119V41.844ZM44.7119 25.2239H53.4717C57.7917 25.2239 57.7917 17.9045 53.4717 17.9045H44.7119V25.2239Z"/></g>
    <g data-g="A"><path d="M107.428 33.4436L101.161 50.9417L99.4658 45.6838H82.7256L80.9258 51.2639H68.6855L83.8662 8.54419H98.2656L107.428 33.4436ZM91.0059 19.1643C90.1059 22.2242 89.4458 24.4446 88.9658 25.9446L85.8457 35.7844H96.2256L93.0459 25.9446C92.1459 23.1246 91.4259 20.9043 91.0059 19.1643Z"/></g>
    <g data-g="slash"><path d="M112.134 59.808H103.986L125.406 0H133.554L112.134 59.808ZM113.986 51.2639H109.193L111.557 44.6633L113.986 51.2639Z"/></g>
    <g data-g="f"><path d="M155.994 13.364C154.134 13.364 151.674 14.204 151.674 17.804V21.644H158.454V27.704H151.674V50.864H144.654V27.704H139.554V21.644H144.654V17.624C144.654 11.084 148.854 7.12402 154.854 7.12402C156.594 7.12402 158.034 7.48402 158.514 7.72402V13.664C158.094 13.544 157.314 13.364 155.994 13.364Z"/></g>
    <g data-g="a"><path d="M160.391 42.944C160.391 37.724 164.231 34.844 169.211 34.124L176.711 32.984C178.391 32.744 178.871 31.904 178.871 30.884C178.871 28.424 177.191 26.444 173.351 26.444C169.691 26.444 167.651 28.784 167.351 31.724L160.991 30.284C161.531 25.244 166.091 20.744 173.291 20.744C182.291 20.744 185.711 25.844 185.711 31.664V46.184C185.711 48.824 186.011 50.564 186.071 50.864H179.591C179.531 50.684 179.291 49.484 179.291 47.144C177.911 49.364 175.031 51.764 170.291 51.764C164.171 51.764 160.391 47.564 160.391 42.944ZM171.611 46.304C175.511 46.304 178.871 44.444 178.871 38.744V37.424L171.251 38.564C169.091 38.924 167.351 40.124 167.351 42.524C167.351 44.504 168.851 46.304 171.611 46.304Z"/></g>
    <g data-g="c"><path d="M205.465 27.164C201.205 27.164 197.425 30.344 197.425 36.224C197.425 42.104 201.205 45.404 205.585 45.404C210.145 45.404 212.245 42.224 212.905 40.004L219.025 42.224C217.645 46.784 213.265 51.764 205.585 51.764C197.005 51.764 190.465 45.104 190.465 36.224C190.465 27.224 197.005 20.744 205.405 20.744C213.265 20.744 217.585 25.664 218.785 30.344L212.545 32.624C211.885 30.044 209.905 27.164 205.465 27.164Z"/></g>
    <g data-g="t"><path d="M232.634 12.704V21.644H238.694V27.824H232.634V41.384C232.634 43.964 233.774 45.044 236.354 45.044C237.314 45.044 238.454 44.864 238.754 44.804V50.564C238.334 50.744 237.014 51.224 234.494 51.224C229.094 51.224 225.734 47.984 225.734 42.524V27.824H220.334V21.644H221.834C224.954 21.644 226.334 19.664 226.334 17.084V12.704H232.634Z"/></g>
    <g data-g="o"><path d="M256.594 45.524C260.914 45.524 264.754 42.344 264.754 36.224C264.754 30.164 260.914 27.044 256.594 27.044C252.334 27.044 248.434 30.164 248.434 36.224C248.434 42.284 252.334 45.524 256.594 45.524ZM256.594 20.744C265.354 20.744 271.774 27.284 271.774 36.224C271.774 45.224 265.354 51.764 256.594 51.764C247.894 51.764 241.474 45.224 241.474 36.224C241.474 27.284 247.894 20.744 256.594 20.744Z"/></g>
    <g data-g="r"><path d="M293.849 21.464V28.544C293.069 28.424 292.289 28.364 291.569 28.364C286.169 28.364 283.709 31.484 283.709 36.944V50.864H276.749V21.644H283.529V26.324C284.909 23.144 288.149 21.284 291.989 21.284C292.829 21.284 293.549 21.404 293.849 21.464Z"/></g>
    <g data-g="y"><path d="M307.046 62.684H299.606L306.626 47.384L294.146 21.644H302.006L310.406 40.124L318.266 21.644H325.646L307.046 62.684Z"/></g>
  </g>
  <g data-g="dot"><circle cx="324.8" cy="46.33" r="4.9" fill="#FEC300"/></g></svg></div></div>

  <!-- Nav flottante (au défilement) -->
  <div class="float-nav" inert="" aria-hidden="true">
    <a class="float-logo" href="#top" aria-label="LBA Factory, accueil"><img src="/media/logo-lba-factory.png" alt="" width="112" height="21"></a>
    <nav class="float-links" aria-label="Sections">
      <span class="float-ind" aria-hidden="true"></span>
      <ul>
          <li><a href="#solutions" data-target="solutions">Solutions</a></li>
          <li><a href="#expertises" data-target="expertises">Expertises</a></li>
          <li><a href="#references" data-target="references">Références</a></li>
          <li><a href="#agence" data-target="agence">L’agence</a></li>
          <li><a href="#recrutement" data-target="recrutement">Nous rejoindre</a></li>
      </ul>
    </nav>
    <span class="float-current" aria-hidden="true"></span>
    <a class="btn btn-accent float-cta" href="#contact"><span class="btn-label" data-label="Parler de votre projet">Parler de votre projet</span></a>
    <button class="btn float-menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-action="open-menu"><span class="sr">Ouvrir le menu</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
  </div>

  <!-- Menu mobile -->
  
    <div id="menu-mobile" class="m-menu" hidden role="dialog" aria-modal="true" aria-label="Menu">
      <div class="m-menu-head">
        <img src="/media/logo-lba-factory.png" alt="" width="128" height="24">
        <button class="btn m-close" type="button" data-action="close-menu"><span class="btn-label" data-label="Fermer">Fermer</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
      </div>
      <nav aria-label="Navigation principale, mobile">
        <ul class="m-links">
            <li><a href="#solutions" data-action="close-menu">Solutions</a></li>
            <li><a href="#expertises" data-action="close-menu">Expertises</a></li>
            <li><a href="#references" data-action="close-menu">Références</a></li>
            <li><a href="#agence" data-action="close-menu">L’agence</a></li>
            <li><a href="#recrutement" data-action="close-menu">Nous rejoindre</a></li>
        </ul>
      </nav>
      <div class="m-foot">
        <ul class="m-langs" aria-label="Langue">
          <li><a href="#fr" lang="fr" hreflang="fr" aria-current="true">Français</a></li>
          <li><a href="#en" lang="en" hreflang="en">English</a></li>
          <li><a href="#ar" lang="ar" hreflang="ar" dir="rtl">العربية</a></li>
        </ul>
        <a class="btn btn-accent" href="#contact" data-action="close-menu"><span class="btn-label" data-label="Parler de votre projet">Parler de votre projet</span></a>
      </div>
    </div>
  

  <!-- En-tête -->
  <div class="site-header on-dark">
    <div class="wrap">
      <header style="display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); block-size: 96px;">
        <a href="#top" aria-label="LBA Factory, accueil" style="display: inline-flex; align-items: center; gap: var(--s-2); min-block-size: 44px; color: inherit; text-decoration: none;">
          <img src="/media/logo-lba-factory.png" alt="" width="168" height="32" style="display: block; inline-size: 168px; block-size: auto;">
        </a>
        <div style="display: flex; align-items: center; gap: var(--s-2);">
          <nav class="nav" aria-label="Navigation principale">
            <ul style="display: flex; gap: 4px;">
              <li><a href="#solutions">Solutions</a></li>
              <li><a href="#expertises">Expertises</a></li>
              <li><a href="#references">Références</a></li>
              <li><a href="#agence">L’agence</a></li>
              <li><a href="#recrutement">Nous rejoindre</a></li>
            </ul>
          </nav>
          <div class="lang-wrap" style="position: relative;">
            <button class="lang-btn" type="button" aria-expanded="false" aria-controls="langues" data-action="toggle-lang"><span class="sr">Langue : </span><span>Français</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
            
              <ul id="langues" class="lang-list" hidden>
                <li><a href="#fr" lang="fr" hreflang="fr" aria-current="true"><span>Français</span><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li>
                <li><a href="#en" lang="en" hreflang="en">English</a></li>
                <li><a href="#ar" lang="ar" hreflang="ar" dir="rtl">العربية</a></li>
              </ul>
            
          </div>
          <a class="btn btn-accent head-cta" href="#contact" style="block-size: 44px;"><span class="btn-label" data-label="Parler de votre projet">Parler de votre projet</span></a>
          <button class="btn menu-btn" type="button" aria-expanded="false" aria-controls="menu-mobile" data-action="open-menu"><span class="btn-label" data-label="Menu">Menu</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
        </div>
      </header>
    </div>
  </div>

  <!-- Hero -->
  <div class="on-dark" style="background: var(--surface-page); color: var(--text-inverse);">
    <div class="wrap">


      <main class="grid hero-grid" style="padding-block: var(--s-8) var(--s-section); align-items: flex-end">
        <div style="grid-column: 1 / span 5; display: flex; flex-direction: column; gap: var(--s-4); justify-content: flex-end">
          <h1>Agence de développement web et applicatif <span class="hl">au Maroc</span></h1>
          <p class="t-lead" style="max-width: 40ch; color: var(--text-secondary-inverse);">Depuis 2016, LBA Factory conçoit et développe vos applications métier, sites web et solutions d’IA.</p>
          <div style="display: flex; gap: var(--s-2); flex-wrap: wrap;">
            <a class="btn btn-accent" href="#contact"><span class="btn-label" data-label="Parler de votre projet">Parler de votre projet</span></a>
            <a class="btn btn-ghost" href="#solutions"><span class="btn-label" data-label="Voir nos solutions">Voir nos solutions</span></a>
          </div>
        </div>
        <div style="grid-column: 6 / span 7; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-2);">
          <div class="squircle" role="region" aria-roledescription="carrousel" aria-label="Photos de l’équipe" style="grid-column: 1 / span 2; position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #2A2A2A;">
            <img class="photo slide" data-slide="0" src="/media/tour-hassan.webp" srcset="/media/tour-hassan-800.webp 1200w, /media/tour-hassan.webp 2576w" sizes="(max-width: 900px) 100vw, 62vw" width="2576" height="1717" decoding="async" fetchpriority="high" alt="L’équipe de LBA Factory au pied de la tour Hassan, à Rabat." aria-hidden="false" style="opacity: 1; transform: scale(1); object-position: 50% 74%;">
<img class="photo slide" data-slide="1" src="/media/bureau-rabat.webp" srcset="/media/bureau-rabat-800.webp 1200w, /media/bureau-rabat.webp 2576w" sizes="(max-width: 900px) 100vw, 62vw" width="2576" height="1717" decoding="async" loading="lazy" alt="Deux développeurs à leur poste dans les bureaux de Rabat." aria-hidden="true" style="opacity: 0; transform: scale(1.05); object-position: 50% 35%;">
<img class="photo slide" data-slide="2" src="/media/binome-ecran.webp" srcset="/media/binome-ecran-800.webp 1200w, /media/binome-ecran.webp 2576w" sizes="(max-width: 900px) 100vw, 62vw" width="2576" height="1717" decoding="async" loading="lazy" alt="Deux développeurs travaillent ensemble sur un ordinateur portable." aria-hidden="true" style="opacity: 0; transform: scale(1.05); object-position: 42% 38%;">
            <div class="pager " data-slider="a" role="group" aria-label="Choisir la photo">
              <button class="pager-dot" type="button" aria-label="Photo 1 sur 3" aria-current="true" data-action="pick" data-index="0"><span><i class="pager-fill"></i></span></button>
<button class="pager-dot" type="button" aria-label="Photo 2 sur 3" aria-current="false" data-action="pick" data-index="1"><span><i class="pager-fill"></i></span></button>
<button class="pager-dot" type="button" aria-label="Photo 3 sur 3" aria-current="false" data-action="pick" data-index="2"><span><i class="pager-fill"></i></span></button>
              <button class="pager-toggle" type="button" aria-label="Mettre en pause le défilement des photos" data-action="toggle-auto" data-slider="a">
                <svg class="ico-pause" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-width="16"></circle><line x1="104" y1="96" x2="104" y2="160" stroke="currentColor" stroke-width="16" stroke-linecap="round"></line><line x1="152" y1="96" x2="152" y2="160" stroke="currentColor" stroke-width="16" stroke-linecap="round"></line></svg>
                <svg class="ico-play" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-width="16"></circle><path d="M112 96 L160 128 L112 160 Z" fill="none" stroke="currentColor" stroke-width="16" stroke-linejoin="round"></path></svg>
              </button>
            </div>
          </div>
          <div class="squircle" style="aspect-ratio: 5 / 4;"><img class="photo" src="/media/calligraphie.webp" srcset="/media/calligraphie-800.webp 1200w, /media/calligraphie.webp 2576w" sizes="(max-width: 900px) 100vw, 34vw" width="2576" height="1717" loading="lazy" decoding="async" alt="Deux collaborateurs relisent un écran devant une calligraphie murale." style="object-position: 55% 30%;"></div>
          <div class="squircle" style="aspect-ratio: 5 / 4;"><img class="photo" src="/media/dev-poste.webp" srcset="/media/dev-poste-800.webp 1200w, /media/dev-poste.webp 2576w" sizes="(max-width: 900px) 100vw, 34vw" width="2576" height="1717" loading="lazy" decoding="async" alt="Un développeur à son poste de travail." style="object-position: 30% 32%;"></div>
          
        </div>
      </main>
    </div>
  </div>

  <!-- Solutions -->
  

  <!-- Expertises -->
  <section id="solutions" class="sec wrap " aria-labelledby="sol-titre" style="padding-block: var(--s-section) var(--s-section-sm); display: flex; flex-direction: column; gap: var(--s-5);">
    <div class="sec-head sec-head-stack">
      <h2 id="sol-titre"><span class="h-muted">Solutions</span> Trois domaines d’intervention</h2>
    </div>
    <div class="cols-3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); align-items: stretch;">
      <article class="card">
        <div style="aspect-ratio: 4 / 3;">
          <div class="illu-zoom"><svg class="illu" viewBox="0 -32 400 368" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
            <line x1="110" y1="80" x2="110" y2="240" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="290" y1="80" x2="290" y2="240" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="200" y1="30" x2="200" y2="275" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
            <circle class="x-rise" style="--d: 0s;" cx="110" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 1.2s;" cx="110" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 0.6s;" cx="290" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 1.8s;" cx="290" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 0.3s;" cx="200" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 2.1s;" cx="200" cy="250" r="2.5" fill="#0A0A0A"></circle>
            <g class="x-down"><polygon points="200,158 290,206 200,254 110,206" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><line x1="110" y1="206" x2="290" y2="206" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="200" y1="158" x2="200" y2="254" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
              <polygon points="200,174 260,206 200,238 140,206" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></polygon></g>
            <g><polygon points="200,102 290,150 200,198 110,150" stroke="#0A0A0A" stroke-width="1" fill="none" style="fill: #F4F3F1;"></polygon>
              <polygon points="170,137 194,150 170,163 146,150" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><polygon points="230,137 254,150 230,163 206,150" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><polygon points="200,121 224,134 200,147 176,134" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><polygon class="x-node" style="--d: .6s;" points="200,153 224,166 200,179 176,166" stroke="#0A0A0A" stroke-width="1"></polygon>
              <line class="x-scan" x1="110" y1="150" x2="140" y2="134" stroke="#FEC300" stroke-width="3" stroke-linecap="round"></line></g>
            <g class="x-up"><polygon points="200,48 290,96 200,144 110,96" stroke="#0A0A0A" stroke-width="1" fill="none" style="fill: #F4F3F1;"></polygon>
              <polygon points="200,68 252,96 200,124 148,96" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></polygon>
              <line class="x-grow" style="--d: 0.00s;" x1="168" y1="104" x2="168" y2="70" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></line><line class="x-grow" style="--d: 0.12s;" x1="190" y1="94" x2="190" y2="42" stroke="#FEC300" stroke-width="4" stroke-linecap="round"></line><line class="x-grow" style="--d: 0.24s;" x1="212" y1="106" x2="212" y2="80" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></line><line class="x-grow" style="--d: 0.36s;" x1="234" y1="96" x2="234" y2="56" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></line></g>
          </svg></div>
        </div>
        <div style="padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2);">
          <h3>Applications métier</h3>
          <p style="color: var(--text-secondary);">Extranets, plateformes de suivi, outils de logistique&nbsp;: des applications sur mesure pour vos équipes.</p>
        </div>
      </article>
      <article class="card">
        <div style="aspect-ratio: 4 / 3;">
          <div class="illu-zoom"><svg class="illu" viewBox="0 -32 400 368" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
            <line x1="50" y1="60" x2="350" y2="60" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="50" y1="244" x2="350" y2="244" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="80" y1="30" x2="80" y2="274" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="320" y1="30" x2="320" y2="274" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
