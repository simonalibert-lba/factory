---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

const title = 'LBA Factory, applications métier, sites web et IA à Rabat';
const description = 'LBA Factory conçoit et développe vos applications métier, sites web et solutions d’IA depuis Rabat, adossée à une agence digitale en France.';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FDFCFC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Intro du logo : activée avant le premier affichage, sauf en mouvement réduit -->
    <script is:inline>try{if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('lbaf-intro')}catch(e){}</script>
  </head>
  <body>
    <div class="lbaf-root emph-couleur" dir="ltr" lang="fr" style="width: 100%; max-width: 1440px; margin-inline: auto; box-sizing: border-box; background: var(--surface-page); font-family: var(--sans); color: var(--text-primary);">
      <div class="intro" aria-hidden="true"><div class="intro-stage"><video class="intro-logo" src="/media/logo-anim.mp4" width="960" height="240" muted playsinline autoplay preload="auto" disablepictureinpicture=""></video></div></div>

      <!-- Nav flottante (au défilement) -->
      <div class="float-nav" inert="" aria-hidden="true">
        <a class="float-logo" href="#top" aria-label="LBA Factory, accueil"><img src="/media/logo-lba-factory.png" alt="" width="112" height="21"></a>
        <nav class="float-links" aria-label="Sections">
          <span class="float-ind" aria-hidden="true"></span>
          <ul>
              <li><a href="#solutions" data-target="solutions">Solutions</a></li>
              <li><a href="#expertises" data-target="expertises">Expertises</a></li>
              <li><a href="#references" data-target="references">Références</a></li>
              <li><a href="#agence" data-target="agence">L’agence</a></li>
              <li><a href="#recrutement" data-target="recrutement">Nous rejoindre</a></li>
          </ul>
        </nav>
        <span class="float-current" aria-hidden="true"></span>
        <a class="btn btn-accent float-cta" href="#contact"><span class="btn-label">Parler de votre projet</span></a>
        <button class="btn float-menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-action="open-menu"><span class="sr">Ouvrir le menu</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
      </div>

      <!-- Menu mobile -->
  
        <div id="menu-mobile" class="m-menu" hidden role="dialog" aria-modal="true" aria-label="Menu">
          <div class="m-menu-head">
            <img src="/media/logo-lba-factory.png" alt="" width="128" height="24">
            <button class="btn m-close" type="button" data-action="close-menu"><span class="btn-label">Fermer</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
          </div>
          <nav aria-label="Navigation principale, mobile">
            <ul class="m-links">
                <li><a href="#solutions" data-action="close-menu">Solutions</a></li>
                <li><a href="#expertises" data-action="close-menu">Expertises</a></li>
                <li><a href="#references" data-action="close-menu">Références</a></li>
                <li><a href="#agence" data-action="close-menu">L’agence</a></li>
                <li><a href="#recrutement" data-action="close-menu">Nous rejoindre</a></li>
            </ul>
          </nav>
          <div class="m-foot">
            <ul class="m-langs" aria-label="Langue">
              <li><a href="#fr" lang="fr" hreflang="fr" aria-current="true">Français</a></li>
              <li><a href="#en" lang="en" hreflang="en">English</a></li>
              <li><a href="#ar" lang="ar" hreflang="ar" dir="rtl">العربية</a></li>
            </ul>
            <a class="btn btn-accent" href="#contact" data-action="close-menu"><span class="btn-label">Parler de votre projet</span><svg class="flip" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 10h12.5M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          </div>
        </div>
  

      <!-- En-tête -->
      <div class="site-header on-dark">
        <div class="wrap">
          <header style="display: flex; align-items: center; justify-content: space-between; gap: 32px; block-size: 96px;">
            <a href="#top" aria-label="LBA Factory, accueil" style="display: inline-flex; align-items: center; gap: 12px; min-block-size: 44px; color: inherit; text-decoration: none;">
              <img src="/media/logo-lba-factory.png" alt="" width="168" height="32" style="display: block; inline-size: 168px; block-size: auto;">
            </a>
            <div style="display: flex; align-items: center; gap: 16px;">
              <nav class="nav" aria-label="Navigation principale">
                <ul style="display: flex; gap: 4px;">
                  <li><a href="#solutions">Solutions</a></li>
                  <li><a href="#expertises">Expertises</a></li>
                  <li><a href="#references">Références</a></li>
                  <li><a href="#agence">L’agence</a></li>
                  <li><a href="#recrutement">Nous rejoindre</a></li>
                </ul>
              </nav>
              <div class="lang-wrap" style="position: relative;">
                <button class="lang-btn" type="button" aria-expanded="false" aria-controls="langues" data-action="toggle-lang"><span class="sr">Langue : </span><span>Français</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
            
                  <ul id="langues" class="lang-list" hidden>
                    <li><a href="#fr" lang="fr" hreflang="fr" aria-current="true"><span>Français</span><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li>
                    <li><a href="#en" lang="en" hreflang="en">English</a></li>
                    <li><a href="#ar" lang="ar" hreflang="ar" dir="rtl">العربية</a></li>
                  </ul>
            
              </div>
              <a class="btn btn-accent head-cta" href="#contact" style="block-size: 44px;"><span class="btn-label">Parler de votre projet</span></a>
              <button class="btn menu-btn" type="button" aria-expanded="false" aria-controls="menu-mobile" data-action="open-menu"><span class="btn-label">Menu</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
            </div>
          </header>
        </div>
      </div>

      <!-- Hero -->
      <div class="on-dark" style="background: var(--surface-page); color: var(--text-inverse);">
        <div class="wrap">


          <main class="grid hero-grid" style="padding-block: 64px 112px; align-items: flex-end">
            <div style="grid-column: 1 / span 5; display: flex; flex-direction: column; gap: 28px; justify-content: flex-end">
              <h1 style="font: 400 64px/1.02 var(--serif); font-size: 46px">Agence de développement web et applicatif <span class="hl">au Maroc</span></h1>
              <p style="font: 400 19px/1.55 var(--sans); max-width: 40ch; color: var(--text-secondary-inverse); font-size: 18px">Depuis <span class="todo">20XX, à fournir</span>, LBA Factory conçoit et développe vos applications métier, sites web et solutions d’IA.</p>
              <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <a class="btn btn-accent" href="#contact"><span class="btn-label" style="font-size: 16px">Parler de votre projet</span><svg class="flip" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 10h12.5M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
                <a class="btn btn-ghost" href="#solutions"><span class="btn-label">Voir nos solutions</span></a>
              </div>
            </div>
            <div style="grid-column: 6 / span 7; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px;">
              <div class="squircle" role="region" aria-roledescription="carrousel" aria-label="Photos de l’équipe" style="grid-column: 1 / span 2; position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #2A2A2A;">
                <img class="photo slide" data-slide="0" src="/media/hero-1.webp" srcset="/media/hero-1-800.webp 800w, /media/hero-1.webp 1600w" sizes="(max-width: 900px) 100vw, 760px" width="1600" height="1067" decoding="async" fetchpriority="high" alt="Une collaboratrice explique un projet à deux collègues autour d’une tablette." aria-hidden="false" style="opacity: 1; transform: scale(1); object-position: 60% 38%;">
    <img class="photo slide" data-slide="1" src="/media/hero-2.webp" srcset="/media/hero-2-800.webp 800w, /media/hero-2.webp 1600w" sizes="(max-width: 900px) 100vw, 760px" width="1600" height="1067" decoding="async" loading="lazy" alt="Deux personnes consultent une tablette au-dessus d’un carnet de croquis." aria-hidden="true" style="opacity: 0; transform: scale(1.14); object-position: 62% 40%;">
    <img class="photo slide" data-slide="2" src="/media/equipe-table.webp" srcset="/media/equipe-table-800.webp 800w, /media/equipe-table.webp 1600w" sizes="(max-width: 900px) 100vw, 760px" width="1600" height="1067" decoding="async" loading="lazy" alt="Une équipe travaille autour d’une table dans un espace de travail lumineux." aria-hidden="true" style="opacity: 0; transform: scale(1.14); object-position: 45% 40%;">
                <div class="pager " data-slider="a" role="group" aria-label="Choisir la photo">
                  <button class="pager-dot" type="button" aria-label="Photo 1 sur 3" aria-current="true" data-action="pick" data-index="0"><span><i class="pager-fill"></i></span></button>
    <button class="pager-dot" type="button" aria-label="Photo 2 sur 3" aria-current="false" data-action="pick" data-index="1"><span><i class="pager-fill"></i></span></button>
    <button class="pager-dot" type="button" aria-label="Photo 3 sur 3" aria-current="false" data-action="pick" data-index="2"><span><i class="pager-fill"></i></span></button>
                  <button class="pager-toggle" type="button" aria-label="Mettre en pause le défilement des photos" data-action="toggle-auto" data-slider="a">
                    <svg class="ico-pause" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-width="16"></circle><line x1="104" y1="96" x2="104" y2="160" stroke="currentColor" stroke-width="16" stroke-linecap="round"></line><line x1="152" y1="96" x2="152" y2="160" stroke="currentColor" stroke-width="16" stroke-linecap="round"></line></svg>
                    <svg class="ico-play" viewBox="0 0 256 256" aria-hidden="true"><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-width="16"></circle><path d="M112 96 L160 128 L112 160 Z" fill="none" stroke="currentColor" stroke-width="16" stroke-linejoin="round"></path></svg>
                  </button>
                </div>
              </div>
              <div class="squircle" style="aspect-ratio: 5 / 4;"><img class="photo" src="/media/hero-reunion.webp" srcset="/media/hero-reunion-800.webp 800w, /media/hero-reunion.webp 1600w" sizes="(max-width: 900px) 100vw, 480px" width="1600" height="1067" loading="lazy" decoding="async" alt="Une collaboratrice échange avec une interlocutrice en réunion." style="object-position: 56% 30%;"></div>
              <div class="squircle" style="aspect-ratio: 5 / 4;"><img class="photo" src="/media/devs-ecran.webp" srcset="/media/devs-ecran-800.webp 800w, /media/devs-ecran.webp 1600w" sizes="(max-width: 900px) 100vw, 480px" width="1600" height="1067" loading="lazy" decoding="async" alt="Trois développeurs étudient un écran ensemble." style="object-position: 55% 30%;"></div>
              <p class="meta" style="grid-column: 1 / span 2;">Photos provisoires, équipe LBA Factory à Rabat à fournir</p>
            </div>
          </main>
        </div>
      </div>

      <!-- Solutions -->
  

      <!-- Expertises -->
      <section id="solutions" class="sec wrap " aria-labelledby="sol-titre" style="padding-block: 112px 96px; display: flex; flex-direction: column; gap: 40px;">
        <div class="sec-head sec-head-stack">
          <p class="surtitre">Trois domaines d’intervention</p>
          <h2 id="sol-titre" style="font: 400 48px/1.05 var(--serif); font-size: 44px">Nos <span class="hl">solutions</span></h2>
        </div>
        <div class="cols-3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch;">
          <article class="card">
            <div style="aspect-ratio: 4 / 3;">
              <div class="illu-zoom"><svg class="illu" viewBox="0 -32 400 368" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
                <line x1="110" y1="80" x2="110" y2="240" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="290" y1="80" x2="290" y2="240" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="200" y1="30" x2="200" y2="275" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
                <circle class="x-rise" style="--d: 0s;" cx="110" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 1.2s;" cx="110" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 0.6s;" cx="290" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 1.8s;" cx="290" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 0.3s;" cx="200" cy="250" r="2.5" fill="#0A0A0A"></circle><circle class="x-rise" style="--d: 2.1s;" cx="200" cy="250" r="2.5" fill="#0A0A0A"></circle>
                <g class="x-down"><polygon points="200,158 290,206 200,254 110,206" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><line x1="110" y1="206" x2="290" y2="206" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="200" y1="158" x2="200" y2="254" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
                  <polygon points="200,174 260,206 200,238 140,206" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></polygon></g>
                <g><polygon points="200,102 290,150 200,198 110,150" stroke="#0A0A0A" stroke-width="1" fill="none" style="fill: #F4F3F1;"></polygon>
                  <polygon points="170,137 194,150 170,163 146,150" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><polygon points="230,137 254,150 230,163 206,150" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><polygon points="200,121 224,134 200,147 176,134" stroke="#0A0A0A" stroke-width="1" fill="none"></polygon><polygon class="x-node" style="--d: .6s;" points="200,153 224,166 200,179 176,166" stroke="#0A0A0A" stroke-width="1"></polygon>
                  <line class="x-scan" x1="110" y1="150" x2="140" y2="134" stroke="#FEC300" stroke-width="3" stroke-linecap="round"></line></g>
                <g class="x-up"><polygon points="200,48 290,96 200,144 110,96" stroke="#0A0A0A" stroke-width="1" fill="none" style="fill: #F4F3F1;"></polygon>
                  <polygon points="200,68 252,96 200,124 148,96" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></polygon>
                  <line class="x-grow" style="--d: 0.00s;" x1="168" y1="104" x2="168" y2="70" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></line><line class="x-grow" style="--d: 0.12s;" x1="190" y1="94" x2="190" y2="42" stroke="#FEC300" stroke-width="4" stroke-linecap="round"></line><line class="x-grow" style="--d: 0.24s;" x1="212" y1="106" x2="212" y2="80" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></line><line class="x-grow" style="--d: 0.36s;" x1="234" y1="96" x2="234" y2="56" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></line></g>
              </svg></div>
            </div>
            <div style="padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 12px;">
              <h3 style="font: 400 32px/1.1 var(--serif); font-size: 28px">Applications métier</h3>
              <p style="font: 400 16px/1.55 var(--sans); color: var(--text-secondary); font-size: 14px">Extranets, plateformes de suivi, outils de logistique&nbsp;: des applications sur mesure pour vos équipes.</p>
            </div>
          </article>
          <article class="card">
            <div style="aspect-ratio: 4 / 3;">
              <div class="illu-zoom"><svg class="illu" viewBox="0 -32 400 368" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
                <line x1="50" y1="60" x2="350" y2="60" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="50" y1="244" x2="350" y2="244" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="80" y1="30" x2="80" y2="274" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line x1="320" y1="30" x2="320" y2="274" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
                <rect class="x-layer" style="--dx: -52px; --dy: -40px; --d: 0s;" x="80" y="60" width="240" height="184" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></rect>
                <rect class="x-layer" style="--dx: -26px; --dy: -20px; --d: .1s;" x="80" y="60" width="240" height="184" stroke="#0A0A0A" stroke-width="1" fill="none"></rect>
                <rect x="80" y="60" width="240" height="184" stroke="#0A0A0A" stroke-width="1" fill="none" style="fill: #F4F3F1;"></rect>
                <rect class="e-draw" style="--d: 0s;" pathLength="1" x="80" y="60" width="240" height="184" stroke="#0A0A0A" stroke-width="1.5" fill="none"></rect>
                <line class="e-draw" style="--d: .15s;" pathLength="1" x1="80" y1="82" x2="320" y2="82" stroke="#0A0A0A" stroke-width="1" fill="none"></line>
                <circle cx="94" cy="71" r="3" stroke="#0A0A0A" stroke-width="1" fill="none"></circle><circle cx="106" cy="71" r="3" stroke="#0A0A0A" stroke-width="1" fill="none"></circle><circle cx="118" cy="71" r="3" stroke="#0A0A0A" stroke-width="1" fill="none"></circle>
                <rect class="e-draw" style="--d: .3s;" pathLength="1" x="96" y="96" width="208" height="56" stroke="#0A0A0A" stroke-width="1" fill="none"></rect>
                <line class="e-draw" style="--d: .35s;" pathLength="1" x1="96" y1="96" x2="304" y2="152" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line><line class="e-draw" style="--d: .4s;" pathLength="1" x1="304" y1="96" x2="96" y2="152" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
                <rect class="e-draw" style="--d: .45s;" pathLength="1" x="96" y="164" width="98" height="64" stroke="#0A0A0A" stroke-width="1" fill="none"></rect>
                <circle class="e-draw" style="--d: .5s;" pathLength="1" cx="145" cy="196" r="18" stroke="#0A0A0A" stroke-width="1" fill="none"></circle>
                <rect class="e-draw" style="--d: .6s;" pathLength="1" x="206" y="164" width="98" height="40" stroke="#0A0A0A" stroke-width="1" fill="none"></rect>
                <rect class="e-fill" x="206" y="212" width="54" height="16" stroke="#0A0A0A" stroke-width="1"></rect>
                <circle class="x-ripple" cx="233" cy="220" r="10" stroke="#FEC300" stroke-width="2" fill="none"></circle>
                <g class="e-cur"><circle cx="306" cy="252" r="9" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></circle><path d="M302 246 L302 262 L306 258 L310 266 L313 264 L309 256 L315 256 Z" fill="#0A0A0A"></path></g>
              </svg></div>
            </div>
            <div style="padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 12px;">
              <h3 style="font: 400 32px/1.1 var(--serif); font-size: 28px">Sites web &amp; e-commerce</h3>
              <p style="font: 400 16px/1.55 var(--sans); color: var(--text-secondary);">Sites, portails et boutiques en ligne sur des technologies open source (Drupal, PrestaShop, Magento).</p>
            </div>
          </article>
          <article class="card">
            <div style="aspect-ratio: 4 / 3;">
              <div class="illu-zoom"><svg class="illu" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
                <line x1="30" y1="150" x2="370" y2="150" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="1 3" fill="none"></line>
